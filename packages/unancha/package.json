{
  "name": "@grausvera/unancha",
  "version": "0.1.0",
  "description": "Recursos visuales de Unancha",
  "license": "MIT",
  "type": "module",
  "sideEffects": ["./assets/motion.css"],
  "files": ["dist", "assets", "catalogue.source.json"],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "tag": "latest"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./catalogue": {
      "types": "./dist/catalogue/index.d.ts",
      "default": "./dist/catalogue/index.js"
    },
    "./icons": {
      "unancha-vue": {
        "types": "./dist/generated/vue/index.d.ts",
        "default": "./dist/generated/vue/index.js"
      },
      "unancha-svelte": {
        "types": "./dist/svelte/index.d.ts",
        "default": "./dist/svelte/index.js"
      },
      "unancha-astro": {
        "types": "./dist/astro/index.d.ts",
        "default": "./dist/astro/index.js"
      },
      "unancha-angular": {
        "types": "./dist/angular/index.d.ts",
        "default": "./dist/angular/index.js"
      },
      "unancha-web": {
        "types": "./dist/web/index.d.ts",
        "default": "./dist/web/index.js"
      },
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./icons/*": {
      "unancha-vue": {
        "types": "./dist/generated/vue/icons/*.d.ts",
        "default": "./dist/generated/vue/icons/*.js"
      },
      "unancha-svelte": {
        "types": "./dist/svelte/icons/*.d.ts",
        "default": "./dist/svelte/icons/*.svelte"
      },
      "unancha-astro": {
        "types": "./dist/astro/icons/*.d.ts",
        "default": "./dist/astro/icons/*.astro"
      },
      "unancha-angular": {
        "types": "./dist/angular/icons/*.d.ts",
        "default": "./dist/angular/icons/*.js"
      },
      "unancha-web": {
        "types": "./dist/generated/web/icons/*.d.ts",
        "default": "./dist/generated/web/icons/*.js"
      },
      "types": "./dist/generated/icons/*.d.ts",
      "default": "./dist/generated/icons/*.js"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "default": "./dist/web/index.js"
    },
    "./web/*": {
      "types": "./dist/generated/web/icons/*.d.ts",
      "default": "./dist/generated/web/icons/*.js"
    },
    "./vue": {
      "types": "./dist/generated/vue/index.d.ts",
      "default": "./dist/generated/vue/index.js"
    },
    "./vue/*": {
      "types": "./dist/generated/vue/icons/*.d.ts",
      "default": "./dist/generated/vue/icons/*.js"
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "svelte": "./dist/svelte/index.js",
      "default": "./dist/svelte/index.js"
    },
    "./svelte/*": {
      "types": "./dist/svelte/icons/*.d.ts",
      "svelte": "./dist/svelte/icons/*.svelte",
      "default": "./dist/svelte/icons/*.svelte"
    },
    "./astro": {
      "types": "./dist/astro/index.d.ts",
      "default": "./dist/astro/index.js"
    },
    "./astro/*": {
      "types": "./dist/astro/icons/*.d.ts",
      "default": "./dist/astro/icons/*.astro"
    },
    "./angular": {
      "types": "./dist/angular/index.d.ts",
      "default": "./dist/angular/index.js"
    },
    "./angular/*": {
      "types": "./dist/angular/icons/*.d.ts",
      "default": "./dist/angular/icons/*.js"
    },
    "./motion.css": "./assets/motion.css",
    "./assets/*": "./assets/*"
  },
  "scripts": {
    "build": "node tooling/generate.mjs && tsc -p tsconfig.json && ngc -p tsconfig.angular.json",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "import:icons": "node tooling/import-icons.mjs",
    "verify:revisions": "node tooling/verify-revisions.mjs",
    "verify:tarball": "node tooling/verify-tarball.mjs"
  },
  "peerDependencies": {
    "@angular/core": "^22.0.0",
    "astro": "^5.7.0 || ^6.0.0 || ^7.0.0",
    "react": "^18.2.0 || ^19.0.0",
    "svelte": "^5.0.0",
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@angular/core": { "optional": true },
    "astro": { "optional": true },
    "react": { "optional": true },
    "svelte": { "optional": true },
    "vue": { "optional": true }
  },
  "devDependencies": {
    "@angular/compiler": "22.3.0",
    "@angular/compiler-cli": "22.3.0",
    "@angular/core": "22.3.0",
    "@svgr/core": "8.1.0",
    "@svgr/plugin-jsx": "8.1.0",
    "@types/react": "19.2.14",
    "@xmldom/xmldom": "0.9.12",
    "astro": "7.4.13",
    "esbuild": "0.28.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "svelte": "5.59.2",
    "typescript": "6.0.3",
    "vue": "3.5.46"
  }
}
